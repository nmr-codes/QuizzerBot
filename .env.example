# ==========================================
# QUIZMASTER AI — Environment Configuration
# ==========================================

# App
APP_NAME=QuizMaster AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-min-32-chars-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql+asyncpg://quizmaster:password@postgres:5432/quizmaster_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_RATE_LIMIT_DB=2

# Bot
BOT_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
OWNER_TELEGRAM_ID=

# AI
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-1.5-flash

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
STORAGE_MAX_FILE_SIZE_MB=50

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Celery
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# Admin
ADMIN_SECRET_KEY=your-admin-secret
ADMIN_SESSION_EXPIRE_HOURS=24

# Payment Providers (fill as needed)
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

PAYNET_MERCHANT_ID=
PAYNET_SECRET_KEY=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
